# ============================================================
# AI Voice Assistant — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Required -----------------------------------------------

# Your Google Gemini API key (get one at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# A long, random secret used to sign Flask session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-flask-secret-key-here

# ---- Optional (with defaults) --------------------------------

# Port the server listens on (default: 5000).
# On Render this is injected automatically — do not set manually.
# PORT=5000

# Host the server binds to (default: 127.0.0.1).
# Set to 0.0.0.0 when deploying to Render.
# HOST=127.0.0.1

# Logging level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO

# Number of Gunicorn worker processes (default: 2).
# On Render, WEB_CONCURRENCY is set automatically.
# WEB_CONCURRENCY=2

# ---- Development only ----------------------------------------

# Set to "true" to enable Flask debug mode locally.
# FLASK_DEBUG=false
